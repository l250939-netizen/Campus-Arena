NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusarena
JWT_SECRET=replace_with_a_strong_secret
CLIENT_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Production deployment settings
# NODE_ENV=production
# PORT=8080
# CLIENT_ORIGIN=https://campusarena.app
# APP_URL=https://campusarena.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="CampusArena <your-email@gmail.com>"
VERIFICATION_RESEND_COOLDOWN_MS=60000
